{
  "expo": {
    "scheme": "homeiloveuk",
    "name": "Homeilove.co.uk",
    "slug": "homeilove-uk",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon 1024x1024.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.revnosoft.homeilove.uk",
      "associatedDomains": [
        "applinks:homeilove.co.uk"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app-icon 1024x1024.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD6UCo-hqB47QTXzS0S0UV8WqwM5x6mECY"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.homeilove.co.uk",
              "pathPrefix": "/CreateNewpass"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.homeilove.co.uk",
              "pathPrefix": "/Account"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.homeilove.co.uk",
              "pathPrefix": "/NewsFeedSingelView"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.homeilove.co.uk",
              "pathPrefix": "/AddSingleView"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.homeilove.co.uk",
              "pathPrefix": "/postRedirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.revnosoft.homeilove.uk"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp",
            "fb",
            "twitter",
            "linkedin"
          ],
          "android": [
            "com.whatsapp",
            "com.facebook.katana",
            "com.linkedin.android",
            "com.twitter.android"
          ]
        }
      ],
  [
  "expo-build-properties",
  {
    "android": {
      "enableMinifyInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    }
  }
]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "GOOGLE_MAPS_API_KEY": "AIzaSyD6UCo-hqB47QTXzS0S0UV8WqwM5x6mECY",
      "eas": {
        "projectId": "8b39deda-2558-4bba-ae5c-3b6bea278cea"
      }
    }
  }
}
