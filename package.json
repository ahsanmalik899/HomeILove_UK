{
  "name": "stable",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-version-check"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "commit": "cz",
    "postinstall": "patch-package",
    "android-production": "eas build --platform android --profile production",
    "ios-production": "eas build --platform ios --profile production",
    "android-dev": "eas build --platform android --profile development",
    "ios-dev": "eas build --platform ios --profile development",
    "ios-auto": "eas build --platform ios --auto-submit",
    "ios-simulatior": "eas build --platform ios --profile development-simulator",
    "prepare": "husky install"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/list": "^3.3.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/material-top-tabs": "^7.3.5",
    "@react-navigation/stack": "^6.3.18",
    "@reduxjs/toolkit": "^1.9.6",
    "@shopify/flash-list": "2.0.2",
    "burnt": "^0.13.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.11.0",
    "formik": "^2.4.6",
    "laravel-echo": "1.15.0",
    "moti": "^0.22.0",
    "nativewind": "^4.1.23",
    "patch-package": "^6.5.1",
    "prop-types": "^15.8.1",
    "pusher-js": "^8.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.24.6",
    "react-native-dotenv": "^3.4.11",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-places-autocomplete": "^2.6.1",
    "react-native-maps": "1.20.1",
    "react-native-mmkv": "3.3.3",
    "react-native-pager-view": "6.9.1",
    "react-native-paper": "5.12.3",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "3.19.5",
    "react-native-safe-area-context": "~5.6.0",
